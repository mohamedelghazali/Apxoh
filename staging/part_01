def unpack_stage_bundles(stage_dir: Path, repo_root: Path) -__GT__ int:
    count = 0
    for bundle in sorted(stage_dir__DOT__glob("eng_part*__DOT__txt")):
        raw = bundle__DOT__read_text(encoding="utf-8")
        restored = raw__DOT__replace("__" + "HTTPS__", "https" + "://")__DOT__replace("__" + "HTTP__", "http" + "://")
        chunks = re__DOT__split(r"^===FILE:([^=\n]+)===\n", restored, flags=re__DOT__M)
        for idx in range(1, len(chunks), 2):
            rel = chunks[idx]__DOT__strip()
            body = chunks[idx + 1]
            dest = repo_root / rel
            dest__DOT__parent__DOT__mkdir(parents=True, exist_ok=True)
            dest__DOT__write_text(body__DOT__rstrip() + "\n", encoding="utf-8")
            count += 1
    return count


