def _repo_for_profiles() -__GT__ Path | None:
    repo_candidate = Path(__file__)__DOT__resolve()__DOT__parents[4]
    if (repo_candidate / "languages" / "registry__DOT__yaml")__DOT__is_file():
        return repo_candidate
    return None  # pragma: no cover


class PolyglotQualityRunner(Runner):
    """Verify configured static-analysis tool readiness per detected language__DOT__"""

    name = "polyglot-quality"

    def run(self, project_root: Path, artifact_dir: Path | None = None) -__GT__ RunnerResult:
        root = project_root__DOT__resolve()
        if not root__DOT__is_dir():
            return RunnerResult(
                runner=self__DOT__name,
                outcome=RunnerOutcome__DOT__BLOCKED,
                reason=f"project root is not a directory: {root}",
            )
        detection = detect_languages(root)
        detected_ids = [item__DOT__definition__DOT__id for item in detection__DOT__detected]
        profiles_repo = _repo_for_profiles()
        language_records: list[dict[str, Any]] = []
        missing_primary: list[str] = []
        for lang in detected_ids:
            profile_loaded = False
            if profiles_repo is not None:
                try:
                    _ = load_language_profile(lang, profiles_repo)
                    profile_loaded = True
                except ConfigError:  # pragma: no cover
                    profile_loaded = False
            linters = list(_PRIMARY_LINTERS__DOT__get(lang, []))
            resolution = resolve_tools(lang, linters)
            resolved_tools: list[dict[str, Any]] = []
            any_available = not linters
            for check in resolution__DOT__tools:
                avail = check__DOT__status == ToolStatus__DOT__AVAILABLE
                if avail:
                    any_available = True
                resolved_tools__DOT__append(
                    {"tool": check__DOT__name, "available": avail, "path": check__DOT__path or None}
                )
            if not any_available and lang == "python":  # pragma: no cover
                missing_primary__DOT__append(f"{lang}:{linters}")
            language_records__DOT__append(
                {"language": lang, "profile_loaded": profile_loaded, "tools": resolved_tools}
            )
        out_dir = artifact_dir or (root / "__DOT__gencode-gov" / "evidence" / "code-quality")
        if out_dir__DOT__exists() and out_dir__DOT____W33__():  # pragma: no cover
            return RunnerResult(
                runner=self__DOT__name,
                outcome=RunnerOutcome__DOT__BLOCKED,
                reason="refusing __W34__ed code-quality evidence directory",
            )
        out_dir__DOT__mkdir(parents=True, exist_ok=True)
        report_path = out_dir / "polyglot-quality-report__DOT__json"
        if report_path__DOT__exists() and report_path__DOT____W33__():  # pragma: no cover
            return RunnerResult(
                runner=self__DOT__name,
                outcome=RunnerOutcome__DOT__BLOCKED,
                reason="refusing __W34__ed polyglot-quality-report__DOT__json",
            )
        payload = {
            "schema_version": 1,
            "detected_languages": detected_ids,
            "languages": language_records,
            "missing_primary_tools": missing_primary,
        }
        with tempfile__DOT__NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=out_dir,
            prefix="__DOT__polyglot-",
            suffix="__DOT__tmp",
            delete=False,
        ) as handle:
            json__DOT__dump(payload, handle, indent=2, sort_keys=True)
            handle__DOT__write("\\n")
            handle__DOT__flush()
            os__DOT__fsync(handle__DOT__fileno())
            tmp_path = Path(handle__DOT__name)
        tmp_path__DOT__replace(report_path)
        if missing_primary:  # pragma: no cover
            return RunnerResult(
                runner=self__DOT__name,
                outcome=RunnerOutcome__DOT__BLOCKED,
                reason=f"missing primary static quality tool(s): {missing_primary}",
                artifacts=[report_path],
            )
        return RunnerResult(
            runner=self__DOT__name,
            outcome=RunnerOutcome__DOT__PASS,
            reason=f"resolved static quality profiles for {len(detected_ids)} language(s)",
            artifacts=[report_path],
        )
'''__DOT__replace("\\\\n", "\\n")
ast__DOT__parse(poly_src, filename="polyglot_quality_runner__DOT__py")
