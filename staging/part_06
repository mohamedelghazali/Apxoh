        hollow: list[str] = []
        for tf in test_files:
            rel = tf__DOT__relative_to(root)__DOT__as_posix()
            try:
                tree = ast__DOT__parse(tf__DOT__read_text(encoding="utf-8"), filename=rel)
            except (OSError, UnicodeDecodeError, SyntaxError):
