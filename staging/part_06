def compute_cyclomatic_complexity(func_node: ast__DOT__FunctionDef | ast__DOT__AsyncFunctionDef) -__GT__ int:
    """Compute McCabe cyclomatic complexity for a Python function or method__DOT__"""
    score = 1
    for child in ast__DOT__walk(func_node):
        if isinstance(
            child,
            (
                ast__DOT__If,
                ast__DOT__For,
                ast__DOT__AsyncFor,
                ast__DOT__While,
                ast__DOT__ExceptHandler,
                ast__DOT__With,
                ast__DOT__AsyncWith,
                ast__DOT__IfExp,
                ast__DOT__comprehension,
            ),
        ):
            score += 1
        elif isinstance(child, ast__DOT__BoolOp):
            score += max(0, len(child__DOT__values) - 1)
    return score


