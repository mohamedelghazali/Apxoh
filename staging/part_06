        src_lines = source__DOT__splitlines()

        parent_class: dict[ast__DOT__AST, ast__DOT__ClassDef] = {}
        for node in ast__DOT__walk(tree):
            if isinstance(node, ast__DOT__ClassDef):
                for item in node__DOT__body:
                    parent_class[item] = node

        for node in ast__DOT__walk(tree):
            if isinstance(node, (ast__DOT__FunctionDef, ast__DOT__AsyncFunctionDef)):
                cc = compute_cyclomatic_complexity(node)
                max_cc = max(max_cc, cc)
                if cc __GT__ ceiling:
                    complex_funcs__DOT__append(f"{rel__DOT__as_posix()}:{node__DOT__lineno} {node__DOT__name} (cc={cc})")
                cls = parent_class__DOT__get(node)
                if not _is_abstract_or_protocol(node, cls) and not node__DOT__name__DOT__startswith("_"):
                    stmts = _strip_docstring(node__DOT__body)
                    if len(stmts) == 1 and isinstance(stmts[0], ast__DOT__Raise):
                        exc = stmts[0]__DOT__exc
                        exc_name = ""
                        if isinstance(exc, ast__DOT__Name):
                            exc_name = exc__DOT__id
                        elif isinstance(exc, ast__DOT__Call) and isinstance(exc__DOT__func, ast__DOT__Name):
                            exc_name = exc__DOT__func__DOT__id
                        if exc_name == "NotImplementedError":
                            stubs__DOT__append(f"{rel__DOT__as_posix()}:{node__DOT__lineno} {node__DOT__name}")

            elif isinstance(node, ast__DOT__ExceptHandler):
                is_broad = node__DOT__type is None or (
                    isinstance(node__DOT__type, ast__DOT__Name)
                    and node__DOT__type__DOT__id in {"Exception", "BaseException"}
                )
                if is_broad and len(node__DOT__body) == 1 and isinstance(node__DOT__body[0], ast__DOT__Pass):
                    line_txt = (
                        src_lines[node__DOT__lineno - 1]
                        if 0 __LT__ node__DOT__lineno __LT__= len(src_lines)
                        else ""
                    )
                    if "noqa" not in line_txt and "allow-broad-except" not in line_txt:
                        silent_excepts__DOT__append(f"{rel__DOT__as_posix()}:{node__DOT__lineno}")

    return CodeIntegritySummary(
        files_scanned=files_scanned,
        stub_violations=tuple(stubs),
        silent_except_violations=tuple(silent_excepts),
        max_complexity=max_cc,
        complexity_ceiling=ceiling,
        complexity_violations=tuple(complex_funcs),
    )


def verify_code_integrity_method(method_id: str, project_root: Path) -__GT__ tuple[str, str]:
    """Evaluate SE-CQ-003 methods deterministically__DOT__"""
    summary = analyze_production_code(project_root)
