def inspect_junit_artifact(artifact_path: Path) -__GT__ tuple[int, int, int, int] | None:
    """Return (tests, failures, errors, skipped) from a JUnit XML artifact, or None__DOT__"""
    if not artifact_path__DOT__is_file() or artifact_path__DOT__is_symlink():
        return None
    try:
        xml_root = ElementTree__DOT__parse(artifact_path, forbid_dtd=True)__DOT__getroot()
        suites = (
            [xml_root]
            if xml_root__DOT__tag == "testsuite"
            else list(xml_root__DOT__findall("testsuite"))
        )
        if not suites:
            return None
        tests = sum(int(s__DOT__get("tests", "0")) for s in suites)
        failures = sum(int(s__DOT__get("failures", "0")) for s in suites)
        errors = sum(int(s__DOT__get("errors", "0")) for s in suites)
        skipped = sum(int(s__DOT__get("skipped", "0")) for s in suites)
    except (ElementTree__DOT__ParseError, DefusedXmlException, OSError, ValueError):
        return None
    if any(count __LT__ 0 for count in (tests, failures, errors, skipped)):
        return None
    return tests, failures, errors, skipped


def evaluate_extended_method(
    method_id: str,
    result: RunnerResult,
    project_root: Path,
    *,
    rule: Any | None = None,
    commit_sha: str | None = None,
) -__GT__ tuple[str, str] | None:
    """Evaluate deterministic test, lint, polyglot, security-audit, and domain methods__DOT__"""
    if result__DOT__outcome == RunnerOutcome__DOT__BLOCKED:
        return STATUS_BLOCKED, result__DOT__reason or "verification runner was blocked"

    if method_id == "security-audit-artifact-verification":
        from gencode_gov__DOT__security_audit__DOT__governance_bridge import evaluate_security_audit_method

        return evaluate_security_audit_method(result)

    if method_id == "negative-security-scenario-traceability":
        return verify_negative_security_scenarios(project_root)

    if method_id == "observability-behavior-test-verification":
        return verify_observability_and_crash_dump_controls(project_root)

    if method_id == "polyglot-static-quality-check":
        if result__DOT__outcome == RunnerOutcome__DOT__PASS:
            return STATUS_PASS, result__DOT__reason or "polyglot static quality profiles verified"
        return STATUS_FAIL, result__DOT__reason or "polyglot static quality check failed"

    if method_id in {
        "automated-test-suite-execution",
        "zero-test-failures-check",
        "test-collector-analysis",
        "skip-marker-detection",
    }:
        reports = [
            Path(p) for p in result__DOT__artifacts if Path(p)__DOT__name == "test-execution-report__DOT__json"
        ]
        if len(reports) != 1 or not reports[0]__DOT__is_file() or reports[0]__DOT__is_symlink():
            return STATUS_BLOCKED, "test-suite runner did not attach test-execution-report__DOT__json"
        try:
            payload = json__DOT__loads(reports[0]__DOT__read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json__DOT__JSONDecodeError):
            return STATUS_BLOCKED, "test-execution-report__DOT__json is unreadable or malformed"
        if not isinstance(payload, dict) or not isinstance(payload__DOT__get("counts"), dict):
            return STATUS_BLOCKED, "test-execution-report__DOT__json counts are malformed"
        counts = payload["counts"]
        total = int(counts__DOT__get("total", 0))
        failed = int(counts__DOT__get("failed", 0))
        errors = int(counts__DOT__get("errors", 0))
        skipped = int(counts__DOT__get("skipped", 0))
        adapter = str(payload__DOT__get("adapter", "unknown"))
        language = str(payload__DOT__get("language", "unknown"))
        if total __LT__= 0:
            return STATUS_BLOCKED, f"{adapter} collected zero executable tests for {language}"
        if method_id in {"automated-test-suite-execution", "test-collector-analysis"}:
            return (
                STATUS_PASS,
                f"{adapter} executed {total} test(s) for {language} with normalized evidence",
            )
        if method_id == "zero-test-failures-check":
            if result__DOT__outcome == RunnerOutcome__DOT__PASS and failed == 0 and errors == 0:
                return (
                    STATUS_PASS,
                    f"{adapter} reported 0 failures and 0 errors across {total} tests",
                )
            return STATUS_FAIL, f"{adapter} reported {failed} failure(s) and {errors} error(s)"
        if skipped == 0:
            return (
                STATUS_PASS,
                f"{adapter} recorded 0 skipped tests across {total} tests",
            )
        return STATUS_FAIL, f"{adapter} recorded {skipped} skipped test(s)"

    if method_id in {"static-lint-execution", "zero-lint-errors-check", "ruff-check"}:
        json_files = [Path(p) for p in result__DOT__artifacts if str(p)__DOT__endswith("__DOT__json")]
        if len(json_files) != 1 or not json_files[0]__DOT__is_file() or json_files[0]__DOT__is_symlink():
            return STATUS_BLOCKED, "Ruff runner did not attach a valid JSON evidence artifact"
        try:
            issues = json__DOT__loads(json_files[0]__DOT__read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json__DOT__JSONDecodeError):
            return STATUS_BLOCKED, "Ruff JSON artifact is unreadable or malformed"
        if not isinstance(issues, list):
            return STATUS_BLOCKED, "Ruff JSON artifact root is not a list"
        if method_id == "static-lint-execution":
            return STATUS_PASS, f"Ruff static analysis executed ({len(issues)} issue(s) recorded)"
        if result__DOT__outcome == RunnerOutcome__DOT__PASS and len(issues) == 0:
            return STATUS_PASS, "Ruff reported zero static analysis issues"
        return STATUS_FAIL, f"Ruff reported {len(issues)} static analysis issue(s)"

    return evaluate_domain_method(
        method_id,
        project_root,
        rule=rule,
        commit_sha=commit_sha,
    )
