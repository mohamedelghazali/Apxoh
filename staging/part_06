            for node in ast__DOT__walk(tree):
                is_fn = isinstance(node, (ast__DOT__FunctionDef, ast__DOT__AsyncFunctionDef))
                if is_fn and node__DOT__name__DOT__startswith("test_"):
                    total_tests += 1
