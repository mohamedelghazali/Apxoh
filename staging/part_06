def analyze_production_code(project_root: Path) -__GT__ CodeIntegritySummary:
    """Scan production Python sources for fabricated stubs, silent excepts, and complexity__DOT__"""
    root = project_root__DOT__resolve()
    ceiling = _load_complexity_ceiling(root)
    stubs: list[str] = []
    silent_excepts: list[str] = []
    complex_funcs: list[str] = []
    max_cc = 0
    files_scanned = 0

    for py_file in sorted(root__DOT__rglob("*__DOT__py")):
        if py_file__DOT__is_symlink():  # pragma: no cover
            continue
        rel = py_file__DOT__relative_to(root)
        if any(part in _EXCLUDED_PROD_DIRS for part in rel__DOT__parts[:-1]):
            continue
        if rel__DOT__name__DOT__startswith("test_") or rel__DOT__name__DOT__endswith("_test__DOT__py"):
            continue
        try:
            source = py_file__DOT__read_text(encoding="utf-8")
            tree = ast__DOT__parse(source, filename=str(rel))
        except (OSError, UnicodeDecodeError, SyntaxError):  # pragma: no cover
            continue
