def _test_has_real_verification(
    func_node: ast__DOT__FunctionDef | ast__DOT__AsyncFunctionDef,
) -__GT__ tuple[bool, bool]:
    """Return (has_verification_action, has_only_tautology)__DOT__"""
    non_tautological_asserts = 0
    tautological_asserts = 0
    helper_verifications = 0

    for child in ast__DOT__walk(func_node):
        if isinstance(child, ast__DOT__Assert):
            if isinstance(child__DOT__test, ast__DOT__Constant) and child__DOT__test__DOT__value is True:
                tautological_asserts += 1
            else:
                non_tautological_asserts += 1
        elif isinstance(child, ast__DOT__Call):
            fn = ""
            if isinstance(child__DOT__func, ast__DOT__Name):
                fn = child__DOT__func__DOT__id
            elif isinstance(child__DOT__func, ast__DOT__Attribute):
                fn = child__DOT__func__DOT__attr
            if (
                fn in {"raises", "warns", "fail", "skip", "xfail"}
                or fn__DOT__startswith("assert")
                or fn__DOT__startswith("_assert")
                or fn__DOT__startswith("verify")
                or fn__DOT__startswith("check")
            ):
                helper_verifications += 1

    has_action = (non_tautological_asserts + helper_verifications) __GT__ 0
    only_tautology = tautological_asserts __GT__ 0 and not has_action
    return has_action, only_tautology


def verify_test_adequacy_method(
