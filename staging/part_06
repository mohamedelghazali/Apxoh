            [git_bin, "diff", "--name-status", f"{base_ref}__DOT____DOT__HEAD"],
            cwd=root,
            capture_output=True,
            text=True,
            check=False,
            timeout=10,
        )
        if res__DOT__returncode != 0:
            return STATUS_BLOCKED, f"git diff against {base_ref} failed: {res__DOT__stderr__DOT__strip()}"
        deleted_tests = [
            ln__DOT__split("	", 1)[1]
            for ln in res__DOT__stdout__DOT__splitlines()
            if ln__DOT__startswith("D	") and ("test_" in ln or "tests/" in ln)
        ]
        if deleted_tests:
            return STATUS_FAIL, f"deleted regression test file(s) in diff: {deleted_tests}"
        return STATUS_PASS, f"zero deleted regression test files between {base_ref} and HEAD"

    return STATUS_BLOCKED, f"unsupported test adequacy method: {method_id}"
