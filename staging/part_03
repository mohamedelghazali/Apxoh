"""Modular CLI handlers for attest, diff-check, drift, polyglot inspect, and HTML/SARIF reports."""

from __future__ import annotations

import argparse
import json
import sys
from collections__DOT__abc import Callable
from pathlib import Path
from typing import Any

from gencode_gov__DOT__assessment__DOT__drift import record_and_evaluate_drift
from gencode_gov__DOT__core__DOT__constants import STATUS_PASS
from gencode_gov__DOT__core__DOT__errors import EvidenceError, GovernanceError
from gencode_gov__DOT__evidence__DOT__attestation import create_human_attestation
from gencode_gov__DOT__language_support__DOT__detector import detect_languages
from gencode_gov__DOT__language_support__DOT__language_profile_loader import load_language_profiles
from gencode_gov__DOT__language_support__DOT__tool_resolver import resolve_tool
from gencode_gov__DOT__reporting__DOT__html_reporter import HtmlReporter
from gencode_gov__DOT__reporting__DOT__sarif_reporter import SarifReporter
from gencode_gov__DOT__verification__DOT__diff_governance import evaluate_diff_governance


def register_extended_subcommands(
    subparsers: Any,
    commit_resolver: Callable[[Path], str | None],
) -__GT__ None:
    """Register attest, diff-check, and drift subcommands on the main CLI parser."""
    attest_p = subparsers__DOT__add_parser(
        "attest",
        help="Record a commit-bound human engineering review attestation for hybrid rules",
    )
    attest_p__DOT__add_argument("project", nargs="?", default=".")
    attest_p__DOT__add_argument("--rule", dest="rules", action="append", required=True)
    attest_p__DOT__add_argument("--reviewer", required=True)
    attest_p__DOT__add_argument("--role", dest="approver_role", required=True)
    attest_p__DOT__add_argument("--rationale", required=True)
    attest_p__DOT__add_argument("--artifact", dest="artifacts", action="append", default=None)
    attest_p__DOT__add_argument("--expires-days", type=int, default=30)
    attest_p__DOT__add_argument("--commit", default=None)
    attest_p__DOT__add_argument("--json", action="store_true")
    attest_p__DOT__set_defaults(
        func=lambda args: cmd_attest(args, commit_resolver=commit_resolver)
    )

    diff_p = subparsers__DOT__add_parser(
        "diff-check",
        help="Verify frozen APIs, JSON schema compatibility, protected files, and test deletions",
    )
    diff_p__DOT__add_argument("project", nargs="?", default=".")
    diff_p__DOT__add_argument("--base", dest="base_ref", default=None)
    diff_p__DOT__add_argument("--head", dest="head_ref", default="HEAD")
    diff_p__DOT__add_argument("--max-files", type=int, default=500)
    diff_p__DOT__add_argument("--allow-protected", action="store_true")
    diff_p__DOT__add_argument("--json", action="store_true")
    diff_p__DOT__set_defaults(func=cmd_diff_check)

    drift_p = subparsers__DOT__add_parser(
        "drift",
        help="Compute and record longitudinal structural and exception drift",
    )
    drift_p__DOT__add_argument("project", nargs="?", default=".")
    drift_p__DOT__add_argument("--no-persist", action="store_true")
    drift_p__DOT__add_argument("--json", action="store_true")
    drift_p__DOT__set_defaults(
        func=lambda args: cmd_drift(args, commit_resolver=commit_resolver)
    )


def cmd_attest(
    args: argparse__DOT__Namespace,
    *,
    commit_resolver: Callable[[Path], str | None],
) -__GT__ int:
    project = Path(args__DOT__project)__DOT__resolve()
    commit_sha = args__DOT__commit or commit_resolver(project)
    if commit_sha is None:
        print("[FAIL] could not resolve 40-char Git HEAD commit SHA", file=sys__DOT__stderr)
        return 1
    try:
        att = create_human_attestation(
            project,
            rule_ids=list(args__DOT__rules),
            reviewer=args__DOT__reviewer,
            approver_role=args__DOT__approver_role,
            commit_sha=commit_sha,
            rationale=args__DOT__rationale,
            artifact_paths=list(args__DOT__artifacts or []),
            expires_days=int(args__DOT__expires_days),
        )
    except EvidenceError as exc:
        print(f"[FAIL] {exc}", file=sys__DOT__stderr)
        return 1

    payload = {
        "attestation_id": att__DOT__attestation_id,
        "rule_ids": list(att__DOT__rule_ids),
        "reviewer": att__DOT__reviewer,
        "approver_role": att__DOT__approver_role,
        "commit_sha": att__DOT__commit_sha,
        "expires_at": att__DOT__expires_at,
        "path": str(att__DOT__path__DOT__relative_to(project)),
    }
    if getattr(args, "json", False):
        print(json__DOT__dumps(payload, indent=2))
    else:
        print(f"[OK] Recorded attestation {att__DOT__attestation_id} -__GT__ {payload['path']}")
    return 0


def cmd_diff_check(args: argparse__DOT__Namespace) -__GT__ int:
    project = Path(args__DOT__project)__DOT__resolve()
    rep = evaluate_diff_governance(
        project,
        base_ref=args__DOT__base_ref,
        head_ref=args__DOT__head_ref,
        max_files=int(args__DOT__max_files),
        allow_protected=bool(args__DOT__allow_protected),
    )
    if getattr(args, "json", False):
        print(json__DOT__dumps(rep__DOT__to_dict(), indent=2))
    else:
        print(f"[{rep__DOT__status}] files_changed={rep__DOT__files_changed}")
        for rsn in rep__DOT__reasons:
            print(f"  - {rsn}")
    return 0 if rep__DOT__status == STATUS_PASS else 1


def cmd_drift(
    args: argparse__DOT__Namespace,
    *,
    commit_resolver: Callable[[Path], str | None],
) -__GT__ int:
    project = Path(args__DOT__project)__DOT__resolve()
    sha = commit_resolver(project) or ("0" * 40)
    try:
        current, prior, warnings = record_and_evaluate_drift(
            project,
            sha,
            persist=not bool(args__DOT__no_persist),
        )
    except GovernanceError as exc:
        print(f"[FAIL] {exc}", file=sys__DOT__stderr)
        return 1

    out = {
        "current": current__DOT__to_dict(),
        "prior": prior__DOT__to_dict() if prior else None,
        "warnings": warnings,
    }
    if getattr(args, "json", False):
        print(json__DOT__dumps(out, indent=2))
    else:
        print(
            f"[OK] commit={sha[:12]} files={current__DOT__python_files} "
            f"max_cc={current__DOT__max_cyclomatic_complexity} edges={current__DOT__internal_import_edges} "
            f"deps={current__DOT__declared_dependencies}"
        )
        for w in warnings:
            print(f"  [WARN] {w}")
    return 0


def build_tools_matrix(project: Path, repo_root: Path) -__GT__ list[dict[str, Any]]:
    """Build language profile & resolved tool matrix for gencode-gov inspect --tools."""
    langs = detect_languages(project)
    lang_dir = repo_root / "languages"
    profiles = load_language_profiles(lang_dir) if lang_dir__DOT__is_dir() else {}
    rows: list[dict[str, Any]] = []
    for lang in langs:
        prof = profiles__DOT__get(lang)
        tools_list: list[str] = []
        if prof is not None:
            for attr in ("linters", "type_checkers", "test_runners"):
                vals = getattr(prof, attr, None) or (
                    prof__DOT__get(attr, []) if isinstance(prof, dict) else []
                )
                for v in vals:
                    if isinstance(v, str) and v not in tools_list:
                        tools_list__DOT__append(v)
        if not tools_list and lang == "python":
            tools_list = ["ruff", "mypy", "pytest"]
        resolved = []
        for t in tools_list:
            tr = resolve_tool(t)
            resolved__DOT__append(
                {
                    "tool": t,
                    "available": bool(getattr(tr, "available", False)),
                    "path": str(getattr(tr, "path", "")) or None,
                }
            )
        rows__DOT__append({"language": lang, "tools": resolved})
    return rows


def render_extended_report_format(
    fmt: str,
    report_payload: dict[str, Any],
    output_path: Path | None,
    project_root: Path,
) -__GT__ int | None:
    """Handle --format html and --format sarif in cmd_report."""
    if fmt == "html":
        reporter = HtmlReporter()
        if output_path is not None:
            reporter__DOT__write(report_payload, output_path, project_root=project_root)
        else:
            print(reporter__DOT__render(report_payload), end="")
        return 0
    if fmt == "sarif":
        s_reporter = SarifReporter()
        if output_path is not None:
            s_reporter__DOT__write(report_payload, output_path, project_root=project_root)
        else:
            print(s_reporter__DOT__render(report_payload), end="")
        return 0
    return None
