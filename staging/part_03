from pathlib import Path
from typing import Any

from gencode_gov__DOT__core__DOT__errors import GovernanceError
from gencode_gov__DOT__policies__DOT__exceptions import load_exceptions
from gencode_gov__DOT__verification__DOT__architecture_verifier import verify_architecture_contracts
from gencode_gov__DOT__verification__DOT__code_and_test_integrity import compute_cyclomatic_complexity


@dataclass(frozen=True)
class DriftSnapshot:
    """Point-in-time structural engineering telemetry for a commit."""

    recorded_at: str
    commit_sha: str
    python_files: int
    max_cyclomatic_complexity: int
    mean_cyclomatic_complexity: float
    internal_import_edges: int
