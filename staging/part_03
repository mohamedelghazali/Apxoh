        return {
            "recorded_at": self__DOT__recorded_at,
            "commit_sha": self__DOT__commit_sha,
            "python_files": self__DOT__python_files,
            "max_cyclomatic_complexity": self__DOT__max_cyclomatic_complexity,
            "mean_cyclomatic_complexity": round(self__DOT__mean_cyclomatic_complexity, 2),
            "internal_import_edges": self__DOT__internal_import_edges,
            "declared_dependencies": self__DOT__declared_dependencies,
            "active_exceptions": self__DOT__active_exceptions,
        }


def compute_drift_snapshot(project_root: Path, commit_sha: str) -__GT__ DriftSnapshot:
    """Measure complexity, coupling, dependency count, and active exceptions."""
    root = project_root__DOT__resolve()
    src_root = root / "src" if (root / "src")__DOT__is_dir() else root
    py_files = 0
    complexities: list[int] = []
    for pf in sorted(src_root__DOT__rglob("*__DOT__py")):
        if pf__DOT__is_symlink() or "__DOT__venv" in pf__DOT__parts or "__pycache__" in pf__DOT__parts:  # pragma: no cover
            continue
        py_files += 1
        try:
            tree = ast__DOT__parse(pf__DOT__read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, SyntaxError):  # pragma: no cover
            continue
        for node in ast__DOT__walk(tree):
            if isinstance(node, (ast__DOT__FunctionDef, ast__DOT__AsyncFunctionDef)):
                complexities__DOT__append(compute_cyclomatic_complexity(node))

    max_cc = max(complexities, default=0)
    mean_cc = (sum(complexities) / len(complexities)) if complexities else 0.0

    arch = verify_architecture_contracts(root)
    dep_count = 0
    pyproj = root / "pyproject__DOT__toml"
    if pyproj__DOT__is_file() and not pyproj__DOT__is_symlink():
        try:
            pdata = tomllib__DOT__loads(pyproj__DOT__read_text(encoding="utf-8"))
            deps = pdata__DOT__get("project", {})__DOT__get("dependencies", [])
            if isinstance(deps, list):
                dep_count = len(deps)
        except (OSError, tomllib__DOT__TOMLDecodeError):  # pragma: no cover
            dep_count = 0

    active_exc = 0
    exc_reg = root / "system" / "policies" / "exceptions" / "registry__DOT__yaml"
    if exc_reg__DOT__is_file() and not exc_reg__DOT__is_symlink():
        try:
            reg = load_exceptions(exc_reg)
            active_exc = sum(1 for item in reg__DOT__exceptions if item__DOT__is_active())
        except Exception:  # noqa: BLE001  # pragma: no cover
            active_exc = 0

    return DriftSnapshot(
        recorded_at=datetime__DOT__now(UTC)__DOT__strftime("%Y-%m-%dT%H:%M:%SZ"),
        commit_sha=commit_sha,
        python_files=py_files,
        max_cyclomatic_complexity=max_cc,
        mean_cyclomatic_complexity=round(mean_cc, 2),
        internal_import_edges=arch__DOT__edge_count,
        declared_dependencies=dep_count,
        active_exceptions=active_exc,
    )


def record_and_evaluate_drift(
    project_root: Path,
    commit_sha: str,
    *,
    persist: bool = True,
) -__GT__ tuple[DriftSnapshot, DriftSnapshot | None, list[str]]:
    """Compare current snapshot against prior ledger entry and optionally append."""
    root = project_root__DOT__resolve()
    state_dir = root / "__DOT__gencode-gov" / "state"
    if state_dir__DOT__exists() and state_dir__DOT__is_symlink():
        raise GovernanceError("refusing symlinked __DOT__gencode-gov/state directory")
    ledger_path = state_dir / "drift-ledger__DOT__jsonl"
    if ledger_path__DOT__exists() and ledger_path__DOT__is_symlink():
        raise GovernanceError("refusing symlinked drift-ledger__DOT__jsonl")

    prior: DriftSnapshot | None = None
    existing_lines: list[str] = []
    if ledger_path__DOT__is_file():
        existing_lines = [
            ln for ln in ledger_path__DOT__read_text(encoding="utf-8")__DOT__splitlines() if ln__DOT__strip()
        ]
        if existing_lines:
            last = json__DOT__loads(existing_lines[-1])
            prior = DriftSnapshot(
                recorded_at=str(last["recorded_at"]),
                commit_sha=str(last["commit_sha"]),
                python_files=int(last["python_files"]),
                max_cyclomatic_complexity=int(last["max_cyclomatic_complexity"]),
                mean_cyclomatic_complexity=float(last["mean_cyclomatic_complexity"]),
                internal_import_edges=int(last["internal_import_edges"]),
                declared_dependencies=int(last["declared_dependencies"]),
                active_exceptions=int(last["active_exceptions"]),
            )

    current = compute_drift_snapshot(root, commit_sha)
    warnings: list[str] = []
    if prior is not None:
        if current__DOT__max_cyclomatic_complexity __GT__ prior__DOT__max_cyclomatic_complexity + 10:
            warnings__DOT__append(
                f"max cyclomatic complexity jumped from {prior__DOT__max_cyclomatic_complexity} "
                f"to {current__DOT__max_cyclomatic_complexity}"
            )
        if current__DOT__declared_dependencies __GT__ prior__DOT__declared_dependencies + 5:
            warnings__DOT__append(
                f"runtime dependency count jumped from {prior__DOT__declared_dependencies} "
                f"to {current__DOT__declared_dependencies}"
            )
        if current__DOT__active_exceptions __GT__ prior__DOT__active_exceptions:
            warnings__DOT__append(
                f"active governance exceptions increased from {prior__DOT__active_exceptions} "
                f"to {current__DOT__active_exceptions}"
            )

    if persist:
        state_dir__DOT__mkdir(parents=True, exist_ok=True)
        state_dir__DOT__resolve()__DOT__relative_to(root)
        serialized = json__DOT__dumps(current__DOT__to_dict(), sort_keys=True)
        updated = [*existing_lines, serialized]
        with tempfile__DOT__NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=state_dir,
            prefix="__DOT__drift-",
            suffix="__DOT__tmp",
            delete=False,
        ) as handle:
            handle__DOT__write("\n"__DOT__join(updated) + "\n")
            handle__DOT__flush()
            os__DOT__fsync(handle__DOT__fileno())
            tmp = Path(handle__DOT__name)
        tmp__DOT__replace(ledger_path)

    return current, prior, warnings
