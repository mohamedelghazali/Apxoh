        raise EvidenceError("refusing symlinked __DOT__gencode-gov directory")
    evid_dir = gov_dir / "evidence"
    if evid_dir__DOT__is_symlink():
        raise EvidenceError("refusing symlinked __DOT__gencode-gov/evidence directory")
    attest_dir = evid_dir / "attestations"
    if attest_dir__DOT__exists() and attest_dir__DOT__is_symlink():
        raise EvidenceError("refusing symlinked attestations directory")
    attest_dir__DOT__mkdir(parents=True, exist_ok=True)
    attest_dir__DOT__resolve()__DOT__relative_to(root)

    target = attest_dir / f"{attest_id}__DOT__json"
    if target__DOT__exists():  # pragma: no cover
        raise EvidenceError(f"attestation already exists: {target}")

