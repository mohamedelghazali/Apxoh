        mode="w",
        encoding="utf-8",
        dir=attest_dir,
        prefix="__DOT__attest-",
        suffix="__DOT__tmp",
        delete=False,
    ) as handle:
        json__DOT__dump(payload, handle, indent=2, sort_keys=True)
        handle__DOT__write("\n")
        handle__DOT__flush()
        os__DOT__fsync(handle__DOT__fileno())
        tmp_path = Path(handle__DOT__name)
    tmp_path__DOT__replace(target)

    return ReviewAttestation(
        attestation_id=attest_id,
        rule_ids=tuple(payload["rule_ids"]),
        reviewer=human,
        approver_role=role,
        commit_sha=commit_sha,
        attested_at=payload["attested_at"],
        expires_at=payload["expires_at"],
        rationale=clean_rationale,
        reviewed_artifacts=tuple(artifacts),
        path=target,
    )


def verify_human_attestation(
    project_root: Path,
    *,
    rule_id: str,
    expected_commit_sha: str | None,
    required_role: str | None = None,
) -__GT__ tuple[str, str]:
    """Verify commit-bound, non-expired, hash-intact human attestation for rule_id."""
    if expected_commit_sha is None or not _COMMIT_RE__DOT__fullmatch(expected_commit_sha):
        return STATUS_BLOCKED, "cannot verify human attestation without a clean Git commit SHA"

    root = project_root__DOT__resolve()
    attest_dir = root / "__DOT__gencode-gov" / "evidence" / "attestations"
    if not attest_dir__DOT__is_dir() or attest_dir__DOT__is_symlink():
        return (
            STATUS_BLOCKED,
            f"authorized human review attestation missing for {rule_id} "
            f"(record via 'gencode-gov attest --rule {rule_id}')",
        )

    now = datetime__DOT__now(UTC)
    schema = _schema_dict()
    stale_reasons: list[str] = []

    for candidate in sorted(attest_dir__DOT__glob("*__DOT__json")):
        if candidate__DOT__is_symlink() or not candidate__DOT__is_file():  # pragma: no cover
            continue
        try:
            data = json__DOT__loads(candidate__DOT__read_text(encoding="utf-8"))
            jsonschema__DOT__validate(instance=data, schema=schema)
        except (OSError, UnicodeDecodeError, json__DOT__JSONDecodeError, jsonschema__DOT__ValidationError):
            stale_reasons__DOT__append(f"malformed attestation {candidate__DOT__name}")
            continue

        if rule_id not in data["rule_ids"]:
            continue

        reviewer = str(data["reviewer"])__DOT__strip()
        if any(tok in reviewer__DOT__lower() for tok in _FORBIDDEN_REVIEWER_TOKENS):
            stale_reasons__DOT__append(f"attestation {data['attestation_id']} uses bot/agent reviewer")
            continue

        if data["commit_sha"] != expected_commit_sha:
            stale_reasons__DOT__append(
                f"attestation {data['attestation_id']} bound to {data['commit_sha'][:12]}, "
                f"not {expected_commit_sha[:12]}"
            )
            continue

        try:
            attested_dt = _parse_utc(data["attested_at"], "attested_at")
            expires_dt = _parse_utc(data["expires_at"], "expires_at")
        except EvidenceError as exc:
            stale_reasons__DOT__append(str(exc))
            continue

        if expires_dt __LT__= now or (expires_dt - attested_dt)__DOT__days __GT__ MAX_ATTESTATION_DAYS:
            stale_reasons__DOT__append(f"attestation {data['attestation_id']} is expired")
            continue

        if required_role and data["approver_role"]__DOT__strip() != required_role__DOT__strip():
            stale_reasons__DOT__append(
                f"attestation {data['attestation_id']} role {data['approver_role']!r} "
                f"!= required {required_role!r}"
            )
            continue

        tampered = False
        for item in data["reviewed_artifacts"]:
            art_path = root / item["path"]
            if art_path__DOT__is_symlink():  # pragma: no cover
                tampered = True
                break
            resolved = art_path__DOT__resolve()
            try:
                resolved__DOT__relative_to(root)
            except ValueError:  # pragma: no cover
                tampered = True
                break
            if not resolved__DOT__is_file() or sha256_of(resolved) != item["sha256"]:
                tampered = True
                break
        if tampered:
            stale_reasons__DOT__append(
                f"attestation {data['attestation_id']} invalidated by modified artifact digest"
            )
            continue

        return (
            STATUS_PASS,
            f"verified commit-bound human attestation {data['attestation_id']} "
            f"by {reviewer} ({data['approver_role']})",
        )

    if stale_reasons:
        return STATUS_BLOCKED, "; "__DOT__join(stale_reasons)
    return (
        STATUS_BLOCKED,
        f"authorized human review attestation missing for {rule_id} at commit "
        f"{expected_commit_sha[:12]}",
    )
