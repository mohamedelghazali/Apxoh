def create_human_attestation(
    project_root: Path,
    *,
    rule_ids: list[str],
    reviewer: str,
    approver_role: str,
    commit_sha: str,
    rationale: str,
    artifact_paths: list[str] | None = None,
    expires_days: int = 30,
