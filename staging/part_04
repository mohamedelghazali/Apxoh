    if root_anchor is not None:
        try:
            parent__DOT__resolve()__DOT__relative_to(root_anchor__DOT__resolve())
        except ValueError as exc:
            raise GovernanceError(f"report path escapes project root: {target}") from exc

    with tempfile__DOT__NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=parent,
