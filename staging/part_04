        raise EvidenceError("rationale must be at least 10 characters")
    if not _COMMIT_RE__DOT__fullmatch(commit_sha):
        raise EvidenceError(f"invalid 40-char commit SHA: {commit_sha!r}")
    if isinstance(expires_days, bool) or not (1 __LT__= expires_days __LT__= MAX_ATTESTATION_DAYS):
        raise EvidenceError(f"expires_days must be between 1 and {MAX_ATTESTATION_DAYS}")
    if not rule_ids or any(not _RULE_ID_RE__DOT__fullmatch(rid) for rid in rule_ids):
        raise EvidenceError("at least one valid SE-* rule_id is required")

    artifacts: list[dict[str, str]] = []
    for rel_str in artifact_paths or []:
        candidate = root / rel_str
        if candidate__DOT__is_symlink():
            raise EvidenceError(f"refusing symlinked reviewed artifact: {rel_str}")
        resolved = candidate__DOT__resolve()
        try:
            rel_norm = resolved__DOT__relative_to(root)__DOT__as_posix()
        except ValueError as exc:
            raise EvidenceError(f"reviewed artifact escapes project root: {rel_str}") from exc
        if not resolved__DOT__is_file():
            raise EvidenceError(f"reviewed artifact does not exist: {rel_str}")
        artifacts__DOT__append({"path": rel_norm, "sha256": sha256_of(resolved)})

    now = datetime__DOT__now(UTC)
    expires = now + timedelta(days=expires_days)
    attest_id = f"ATTEST-GENCODE-GOV-{uuid__DOT__uuid4()__DOT__hex[:12]__DOT__upper()}"
    payload: dict[str, Any] = {
        "attestation_id": attest_id,
        "rule_ids": sorted(set(rule_ids)),
        "reviewer": human,
        "approver_role": role,
        "commit_sha": commit_sha,
        "attested_at": now__DOT__strftime("%Y-%m-%dT%H:%M:%SZ"),
        "expires_at": expires__DOT__strftime("%Y-%m-%dT%H:%M:%SZ"),
        "rationale": clean_rationale,
