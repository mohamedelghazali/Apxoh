def _atomic_safe_write(target: Path, content: str, root_anchor: Path | None = None) -__GT__ Path:
    if target__DOT__exists() and target__DOT__is_symlink():
        raise GovernanceError(f"refusing to write report through symlink: {target}")
    parent = target__DOT__parent
    if parent__DOT__exists() and parent__DOT__is_symlink():
        raise GovernanceError(f"refusing symlinked report parent directory: {parent}")
