        if py_file__DOT__is_symlink():  # pragma: no cover
            continue
        rel = py_file__DOT__relative_to(pkg_root)
        top_mod = rel__DOT__stem if len(rel__DOT__parts) == 1 else rel__DOT__parts[0]
        if top_mod == "__init__":
            continue
        py_count += 1
        all_graph__DOT__setdefault(top_mod, set())
        top_graph__DOT__setdefault(top_mod, set())
        try:
            src_txt = py_file__DOT__read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):  # pragma: no cover
            continue
        all_graph[top_mod]__DOT__update(_extract_submodules(src_txt, pkg_name, top_mod))
        top_graph[top_mod]__DOT__update(
            _extract_submodules(src_txt, pkg_name, top_mod, top_level_only=True)
        )

    edge_count = sum(len(v) for v in all_graph__DOT__values())
    cycles = _find_strongly_connected_cycles(top_graph)
    violations: list[str] = []

    for layer in layers:
        layer_name = str(layer__DOT__get("name", "unnamed"))
        mods = [str(m) for m in layer__DOT__get("modules", []) if isinstance(m, str)]
        forbidden = {str(f) for f in layer__DOT__get("forbidden_imports", []) if isinstance(f, str)}
        for mod in mods:
            bad = sorted(all_graph__DOT__get(mod, set()) & forbidden)
            for target in bad:
                violations__DOT__append(
                    f"layer '{layer_name}' module '{mod}' imports forbidden '{target}'"
                )

    if violations or len(cycles) __GT__ max_cycles:
        reasons: list[str] = list(violations)
        if len(cycles) __GT__ max_cycles:
            formatted = [" __LT__-__GT__ "__DOT__join(c) for c in cycles[:5]]
            reasons__DOT__append(
                f"circular package dependencies ({len(cycles)} __GT__ {max_cycles}): {formatted}"
            )
        return ArchitectureReport(
            STATUS_FAIL,
            "; "__DOT__join(reasons),
            py_count,
            edge_count,
            tuple(cycles),
            tuple(violations),
        )

    return ArchitectureReport(
        STATUS_PASS,
        f"verified {py_count} module files ({edge_count} internal edges, {len(cycles)} cycles, "
        "0 layer violations)",
        py_count,
        edge_count,
        tuple(cycles),
        (),
    )
