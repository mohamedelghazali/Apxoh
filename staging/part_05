                rule_id=rule__DOT__id,
                domain=domain,
                enforcement=enforcement,
                status=STATUS_ACCEPTED_RISK,
                reason=f"accepted risk under active exception {exc_id} ({final_reason})",
                methods=tuple(method_outcomes),
                exception_id=exc_id,
            )

        return EvaluatedRule(
            rule_id=rule__DOT__id,
            domain=domain,
            enforcement=enforcement,
            status=final_status,
            reason=final_reason,
            methods=tuple(method_outcomes),
        )

    def evaluate_all(self, rules: list[Any] | tuple[Any, ...]) -__GT__ tuple[EvaluatedRule, ...]:
        return tuple(self__DOT__evaluate_rule(r) for r in rules)
