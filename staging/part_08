    doc = _load_yaml_safe(db_gov)
    if doc is None:
        return STATUS_FAIL, "malformed __DOT__gencode-gov/database-governance__DOT__yaml"
    controls = doc__DOT__get("controls", {})
    if not isinstance(controls, dict) or controls__DOT__get(method_id) is not True:
        return STATUS_FAIL, f"control {method_id!r} unverified in database-governance__DOT__yaml"
    return STATUS_PASS, f"verified {method_id} in __DOT__gencode-gov/database-governance__DOT__yaml"


def _verify_api_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    if method_id in {"frozen-api-contract-check", "schema-compatibility-diff-check"}:
        rep = evaluate_diff_governance(root)
        if rep__DOT__status == STATUS_BLOCKED:
            return STATUS_BLOCKED, "; "__DOT__join(rep__DOT__reasons) or "diff governance blocked"
        if method_id == "frozen-api-contract-check":
            if rep__DOT__frozen_api_failures:
                return STATUS_FAIL, f"frozen API contract failures: {list(rep__DOT__frozen_api_failures)}"
            return STATUS_PASS, "all declared frozen_apis symbols verified on disk"
        if rep__DOT__schema_breaking_changes:
            return STATUS_FAIL, f"schema breaking changes: {list(rep__DOT__schema_breaking_changes)}"
        return STATUS_PASS, "JSON schema backward-compatibility check passed"

    schemas_dir = root / "schemas"
    openapi_files = [
        p
        for p in [root / "openapi__DOT__yaml", root / "openapi__DOT__json", root / "docs" / "openapi__DOT__yaml"]
        if p__DOT__is_file()
    ]
    json_schemas = sorted(schemas_dir__DOT__glob("*__DOT__schema__DOT__json")) if schemas_dir__DOT__is_dir() else []
    if not json_schemas and not openapi_files:
        return STATUS_BLOCKED, "no schemas/*__DOT__schema__DOT__json or OpenAPI contract files found"

    unversioned: list[str] = []
    for js in json_schemas:
        if js__DOT__is_symlink():
            continue
        try:
            data = json__DOT__loads(js__DOT__read_text(encoding="utf-8"))
        except (OSError, json__DOT__JSONDecodeError):
            return STATUS_FAIL, f"malformed JSON schema: {js__DOT__name}"
        sid = str(data__DOT__get("$id", ""))
        if not re__DOT__search(r"\d+\__DOT__\d+\__DOT__\d+|/v\d+", sid):
            unversioned__DOT__append(js__DOT__name)
    if method_id == "endpoint-version-inventory" and unversioned:
        return STATUS_FAIL, f"schemas missing explicit semantic version in $id: {unversioned}"
    return (
        STATUS_PASS,
        f"verified {len(json_schemas)} JSON schema(s) and {len(openapi_files)} OpenAPI spec(s)",
    )


def _verify_devops_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    wf_dir = root / "__DOT__github" / "workflows"
    workflows = (
        [
            p
            for p in sorted(wf_dir__DOT__glob("*__DOT__yml")) + sorted(wf_dir__DOT__glob("*__DOT__yaml"))
            if not p__DOT__is_symlink()
        ]
        if wf_dir__DOT__is_dir()
        else []
    )
    if method_id == "workflow-file-presence":
        if not workflows:
            return STATUS_FAIL, "no CI workflow files found under __DOT__github/workflows/"
        return STATUS_PASS, f"verified {len(workflows)} GitHub Actions workflow file(s)"

    if method_id == "branch-protection-check":
        proj = _safe_file(root, "__DOT__gencode-gov/project__DOT__yaml")
        cfg = _safe_file(root, "__DOT__gencode-gov/config__DOT__yaml")
        if workflows and (proj is not None or cfg is not None):
            return STATUS_PASS, f"CI workflows ({len(workflows)}) and governance config present"
        return STATUS_BLOCKED, "branch protection & CI gate configuration missing"

    if method_id == "github-actions-sha-pinning-scan":
        if not workflows:
            return STATUS_BLOCKED, "no GitHub Actions workflows present to verify SHA pinning"
        unpinned: list[str] = []
        for wf in workflows:
            wf_lines = wf__DOT__read_text(encoding="utf-8", errors="ignore")__DOT__splitlines()
            for lineno, line in enumerate(wf_lines, 1):
                stripped = line__DOT__strip()
                if stripped__DOT__startswith("#") or "uses:" not in stripped:
                    continue
                after = stripped__DOT__split("uses:", 1)[1]__DOT__strip()
                ref_part = after__DOT__split("#", 1)[0]__DOT__strip()__DOT__strip("'\"")
                if not ref_part or ref_part__DOT__startswith("__DOT__/"):
                    continue
                # slsa-github-generator requires @vX__DOT__Y__DOT__Z tag for OIDC verification
                if ref_part__DOT__startswith("slsa-framework/slsa-github-generator"):
                    continue
                if "@" not in ref_part:
                    unpinned__DOT__append(f"{wf__DOT__name}:{lineno}")
                    continue
                _, rev = ref_part__DOT__rsplit("@", 1)
                if not _SHA40_RE__DOT__fullmatch(rev):
                    unpinned__DOT__append(f"{wf__DOT__name}:{lineno} ({ref_part})")
        if unpinned:
            return STATUS_FAIL, f"mutable non-SHA GitHub Action reference(s): {unpinned[:5]}"
        return STATUS_PASS, f"all external Actions across {len(workflows)} workflows SHA-pinned"

    if method_id == "dependency-lockfile-determinism-check":
        lockfiles = [
            name
            for name in (
                "requirements__DOT__lock",
                "requirements-dev__DOT__lock",
                "uv__DOT__lock",
                "poetry__DOT__lock",
                "Cargo__DOT__lock",
                "package-lock__DOT__json",
                "pnpm-lock__DOT__yaml",
                "go__DOT__sum",
            )
            if _safe_file(root, name) is not None
        ]
        if not lockfiles:
            return STATUS_FAIL, "no deterministic dependency lockfile found in repository root"
        return STATUS_PASS, f"verified deterministic dependency lockfile(s): {lockfiles}"

    return STATUS_BLOCKED, f"unsupported devops method: {method_id}"


def _verify_maintenance_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    changelog = _safe_file(root, "CHANGELOG__DOT__md")
    if method_id == "changelog-format-validation":
        if changelog is None:
            return STATUS_FAIL, "missing CHANGELOG__DOT__md"
        txt = changelog__DOT__read_text(encoding="utf-8", errors="ignore")
        if "## [" not in txt and "## v" not in txt and "## 0__DOT__" not in txt and "## 1__DOT__" not in txt:
            return STATUS_FAIL, "CHANGELOG__DOT__md lacks Keep-a-Changelog version headings"
        return STATUS_PASS, "CHANGELOG__DOT__md format and version headings verified"

    if method_id == "version-consistency-check":
        pyproj = _safe_file(root, "pyproject__DOT__toml")
        if pyproj is None:
            return STATUS_BLOCKED, "no pyproject__DOT__toml present for version parity verification"
        try:
            pdata = tomllib__DOT__loads(pyproj__DOT__read_text(encoding="utf-8"))
        except tomllib__DOT__TOMLDecodeError as exc:
            return STATUS_FAIL, f"invalid pyproject__DOT__toml: {exc}"
        declared = str(pdata__DOT__get("project", {})__DOT__get("version", ""))__DOT__strip()
        if not declared:
            return STATUS_FAIL, "pyproject__DOT__toml missing project__DOT__version"
        src_dir = root / "src"
        if src_dir__DOT__is_dir():
            for init_py in sorted(src_dir__DOT__glob("*/__init____DOT__py")):
                if init_py__DOT__is_symlink():
                    continue
                txt = init_py__DOT__read_text(encoding="utf-8", errors="ignore")
                m = re__DOT__search(r'__version__\s*=\s*["\']([^"\']+)["\']', txt)
                if m and m__DOT__group(1) != declared:
                    return (
                        STATUS_FAIL,
                        f"version mismatch: {declared!r} vs {m__DOT__group(1)!r}",
                    )
        return STATUS_PASS, f"version {declared} consistent across metadata and __version__"

    return STATUS_BLOCKED, f"unsupported maintenance method: {method_id}"


def _verify_release_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    notes = _safe_file(root, "RELEASE_NOTES__DOT__md") or _safe_file(root, "CHANGELOG__DOT__md")
