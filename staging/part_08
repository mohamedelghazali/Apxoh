    doc = _load_yaml_safe(art)
    if doc is None:
        return STATUS_FAIL, f"malformed YAML in {artifact_rel}"
    methods_map = doc__DOT__get("verified_methods", doc__DOT__get("controls", {}))
    if isinstance(methods_map, dict):
        val = methods_map__DOT__get(method_id)
        if val is True or (isinstance(val, dict) and val__DOT__get("status") == "PASS"):
            return STATUS_PASS, f"verified {method_id} in {artifact_rel}"
        if val is False or (isinstance(val, dict) and val__DOT__get("status") == "FAIL"):
            return STATUS_FAIL, f"{method_id} reported FAIL in {artifact_rel}"
    return STATUS_BLOCKED, f"{method_id} not yet verified in {artifact_rel}"


def _verify_testing_auxiliary_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    if method_id == "coverage-analysis":
        pyproj = _safe_file(root, "pyproject__DOT__toml")
        if pyproj is not None:
            try:
                data = tomllib__DOT__loads(pyproj__DOT__read_text(encoding="utf-8"))
                cov_rep = data__DOT__get("tool", {})__DOT__get("coverage", {})__DOT__get("report", {})
                fail_under = cov_rep__DOT__get("fail_under", 0)
                if isinstance(fail_under, (int, float)) and fail_under __GT__= 80:
                    return STATUS_PASS, f"coverage gate enforced (fail_under={fail_under}%)"
            except tomllib__DOT__TOMLDecodeError:
                return STATUS_FAIL, "malformed pyproject__DOT__toml during coverage-analysis"
        cov_json = _safe_file(root, "__DOT__gencode-gov/evidence/testing/coverage__DOT__json")
        if cov_json is not None:
            try:
                cdata = json__DOT__loads(cov_json__DOT__read_text(encoding="utf-8"))
                pct = float(cdata__DOT__get("totals", {})__DOT__get("percent_covered", 0__DOT__0))
                if pct __GT__= 80__DOT__0:
                    return STATUS_PASS, f"measured test coverage {pct:__DOT__2f}% __GT__= 80__DOT__0%"
                return STATUS_FAIL, f"measured test coverage {pct:__DOT__2f}% __LT__ 80__DOT__0%"
            except (OSError, ValueError, json__DOT__JSONDecodeError):
                return STATUS_FAIL, "malformed coverage__DOT__json evidence"
        return STATUS_BLOCKED, "no coverage gate (__GT__=80%) or coverage__DOT__json artifact found"

    if method_id == "ast-test-mapping":
        src_files = (
            [p for p in sorted((root / "src")__DOT__rglob("*__DOT__py")) if p__DOT__name != "__init____DOT__py"]
            if (root / "src")__DOT__is_dir()
            else []
        )
        test_files = (
            sorted((root / "tests")__DOT__rglob("test_*__DOT__py")) if (root / "tests")__DOT__is_dir() else []
        )
        if not src_files:
            return STATUS_PASS, "no Python src/ modules requiring AST test mapping"
        if not test_files:
            return STATUS_FAIL, f"found {len(src_files)} src/ modules without tests"
        return STATUS_PASS, f"mapped {len(src_files)} module(s) across {len(test_files)} tests"

    if method_id in {"commit-message-analysis", "test-diff-analysis"}:
        test_dir = root / "tests"
        if not test_dir__DOT__is_dir() or not list(test_dir__DOT__rglob("test_*__DOT__py")):
            return STATUS_BLOCKED, "no regression test suite found under tests/"
        return STATUS_PASS, f"{method_id} verified regression test suite presence under tests/"

    if method_id == "critical-workflow-test-coverage-review":
        matrix = _safe_file(root, "__DOT__gencode-gov/security-test-matrix__DOT__yaml") or _safe_file(
            root, "__DOT__gencode-gov/critical-workflows__DOT__yaml"
        )
        if matrix is None:
            return STATUS_BLOCKED, "missing security-test-matrix__DOT__yaml or critical-workflows__DOT__yaml"
        doc = _load_yaml_safe(matrix)
        if doc is None:
            return STATUS_FAIL, f"malformed {matrix__DOT__name}"
        return STATUS_PASS, f"critical workflow test mapping verified in {matrix__DOT__name}"

    return STATUS_BLOCKED, f"unsupported testing method: {method_id}"


def evaluate_domain_method(
    method_id: str,
    project_root: Path,
    *,
    rule: Any | None = None,
    commit_sha: str | None = None,
) -__GT__ tuple[str, str] | None:
    """Dispatch deterministic verification for any domain or human-attestation method__DOT__"""
    root = project_root__DOT__resolve()

    if method_id in {"human-review", "human-security-review", "human-approval"}:
        sha = commit_sha or _resolve_head_sha(root)
        rule_id = getattr(rule, "id", None)
        approver_role: str | None = None
        raw = getattr(rule, "raw", None)
        if isinstance(raw, dict) and isinstance(raw__DOT__get("human_review"), dict):
            role_val = raw["human_review"]__DOT__get("approver_role")
            if isinstance(role_val, str) and role_val__DOT__strip():
                approver_role = role_val__DOT__strip()
        if isinstance(rule_id, str) and rule_id:
            return verify_human_attestation(
