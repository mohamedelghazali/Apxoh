def _verify_reliability_resilience_ast(method_id: str, root: Path) -__GT__ tuple[str, str]:
    src_root = root / "src" if (root / "src")__DOT__is_dir() else root
    missing_timeouts: list[str] = []
    unbounded_loops: list[str] = []
    scanned = 0

    for py_file in sorted(src_root__DOT__rglob("*__DOT__py")):
        if py_file__DOT__is_symlink() or any(
            p in {"tests", "examples", "__DOT__venv", "venv", "__pycache__"} for p in py_file__DOT__parts
        ):
            continue
        try:
            tree = ast__DOT__parse(py_file__DOT__read_text(encoding="utf-8"), filename=str(py_file))
        except (OSError, UnicodeDecodeError, SyntaxError):
            continue
        scanned += 1
        rel = py_file__DOT__relative_to(root)__DOT__as_posix()

        for node in ast__DOT__walk(tree):
            if isinstance(node, ast__DOT__Call) and isinstance(node__DOT__func, ast__DOT__Attribute):
                attr = node__DOT__func__DOT__attr
                owner = node__DOT__func__DOT__value__DOT__id if isinstance(node__DOT__func__DOT__value, ast__DOT__Name) else ""
                if attr in _NETWORK_CALL_NAMES and (
                    owner in _NETWORK_MODULES or (owner == "request" and attr == "urlopen")
                ):
                    has_timeout = any(kw__DOT__arg == "timeout" for kw in node__DOT__keywords)
                    if not has_timeout:
                        missing_timeouts__DOT__append(f"{rel}:{node__DOT__lineno} ({owner}__DOT__{attr})")
            elif isinstance(node, ast__DOT__While):
                if isinstance(node__DOT__test, ast__DOT__Constant) and node__DOT__test__DOT__value is True:
                    has_exit = any(
                        isinstance(sub, (ast__DOT__Break, ast__DOT__Return, ast__DOT__Raise))
                        for sub in ast__DOT__walk(node)
                    )
                    if not has_exit:
                        unbounded_loops__DOT__append(f"{rel}:{node__DOT__lineno}")

    if method_id == "outbound-timeout-enforcement-scan":
        if missing_timeouts:
            return STATUS_FAIL, f"outbound network call(s) missing timeout=: {missing_timeouts[:5]}"
        return STATUS_PASS, f"scanned {scanned} module(s); 0 calls missing timeout"

    if unbounded_loops:
        return STATUS_FAIL, f"unbounded while True loop(s): {unbounded_loops[:5]}"
    return STATUS_PASS, f"scanned {scanned} production module(s); all retry/poll loops bounded"


def _verify_sbom_and_security_methods(method_id: str, root: Path) -__GT__ tuple[str, str]:
    if method_id in {
        "secret-scanner",
        "working-tree-secret-scan",
        "env-file-audit",
        "repository-config-review",
    }:
        committed_env = [
            p__DOT__relative_to(root)__DOT__as_posix()
            for p in sorted(root__DOT__rglob("__DOT__env"))
            if not p__DOT__is_symlink() and "__DOT__venv" not in p__DOT__parts and "examples" not in p__DOT__parts
        ]
        if method_id == "env-file-audit" and committed_env:
            return STATUS_FAIL, f"committed plaintext __DOT__env file(s) found: {committed_env}"

        secret_hits: list[str] = []
        for candidate in sorted(root__DOT__rglob("*")):
            if (
                not candidate__DOT__is_file()
                or candidate__DOT__is_symlink()
                or any(
                    part in {"__DOT__git", "__DOT__venv", "venv", "__pycache__", "tests", "__DOT__gencode-gov"}
                    for part in candidate__DOT__parts
                )
            ):
                continue
            allowed_ext = {"__DOT__py", "__DOT__yaml", "__DOT__yml", "__DOT__json", "__DOT__toml", "__DOT__env", "__DOT__sh"}
            if candidate__DOT__suffix__DOT__lower() not in allowed_ext:
                continue
            try:
                if candidate__DOT__stat()__DOT__st_size __GT__ 256 * 1024:
                    continue
                txt = candidate__DOT__read_text(encoding="utf-8", errors="ignore")
            except OSError:  # pragma: no cover
                continue
            if _SECRET_ASSIGN_RE__DOT__search(txt):
                secret_hits__DOT__append(candidate__DOT__relative_to(root)__DOT__as_posix())
        if secret_hits:
            return STATUS_FAIL, f"hardcoded credential pattern(s) detected in: {secret_hits[:5]}"
        return STATUS_PASS, f"{method_id} verified clean tree (0 secrets or __DOT__env leaks)"

    if method_id == "lockfile-inventory":
        return _verify_devops_methods("dependency-lockfile-determinism-check", root)

    if method_id in {"sbom-component-inventory-check", "sbom-license-and-cve-policy-check"}:
        sbom_candidates = [
            root / "__DOT__gencode-gov" / "evidence" / "supply-chain" / "sbom__DOT__cdx__DOT__json",
            root / "sbom__DOT__cdx__DOT__json",
        ]
        sbom_file = next((p for p in sbom_candidates if p__DOT__is_file() and not p__DOT__is_symlink()), None)
        if sbom_file is not None:
            try:
                sbom = json__DOT__loads(sbom_file__DOT__read_text(encoding="utf-8"))
            except (OSError, json__DOT__JSONDecodeError) as exc:
                return STATUS_FAIL, f"malformed CycloneDX SBOM {sbom_file__DOT__name}: {exc}"
            comps = sbom__DOT__get("components", [])
            if not isinstance(comps, list) or not comps:
                return STATUS_FAIL, "CycloneDX SBOM contains zero components"
            if method_id == "sbom-component-inventory-check":
                return STATUS_PASS, f"verified CycloneDX SBOM with {len(comps)} component(s)"
            bad_lic: list[str] = []
            for comp in comps:
                if not isinstance(comp, dict):
                    continue
                for lic_entry in comp__DOT__get("licenses", []):
                    if isinstance(lic_entry, dict) and isinstance(lic_entry__DOT__get("license"), dict):
                        lid = str(lic_entry["license"]__DOT__get("id", ""))
                        if lid in _FORBIDDEN_LICENSES:
                            bad_lic__DOT__append(f"{comp__DOT__get('name')}:{lid}")
            vulns = sbom__DOT__get("vulnerabilities", [])
            crit_vulns = [
                str(v__DOT__get("id"))
                for v in (vulns if isinstance(vulns, list) else [])
                if isinstance(v, dict)
                and any(
                    isinstance(r, dict)
                    and str(r__DOT__get("severity", ""))__DOT__lower() in {"critical", "high"}
                    for r in v__DOT__get("ratings", [])
                )
            ]
            if bad_lic or crit_vulns:
                return STATUS_FAIL, f"SBOM violations: lic={bad_lic}, vulns={crit_vulns}"
            return STATUS_PASS, f"verified {len(comps)} SBOM components: 0 policy violations"

        # Fallback deterministic manifest + lockfile check when CycloneDX file is absent
        lock_status, lock_msg = _verify_devops_methods(
            "dependency-lockfile-determinism-check", root
        )
        if lock_status != STATUS_PASS:
            return STATUS_BLOCKED, "neither CycloneDX SBOM nor pinned dependency lockfile found"
        if method_id == "sbom-component-inventory-check":
            return STATUS_PASS, f"component inventory anchored by pinned lockfiles ({lock_msg})"
        pyproj = _safe_file(root, "pyproject__DOT__toml")
        if pyproj is not None:
            txt = pyproj__DOT__read_text(encoding="utf-8", errors="ignore")
            if any(lic in txt for lic in _FORBIDDEN_LICENSES):
                return STATUS_FAIL, "forbidden copyleft license declared in pyproject__DOT__toml"
        return STATUS_PASS, "package license metadata and pinned lockfiles compliant"

    sec_doc_path = _safe_file(root, "__DOT__gencode-gov/security-controls__DOT__yaml")
    if sec_doc_path is None:
        return (
            STATUS_BLOCKED,
            f"missing __DOT__gencode-gov/security-controls__DOT__yaml verification record for {method_id}",
        )
    sec_doc = _load_yaml_safe(sec_doc_path)
    if sec_doc is None or not isinstance(sec_doc__DOT__get("verified_methods"), dict):
        return STATUS_FAIL, "malformed __DOT__gencode-gov/security-controls__DOT__yaml"
    entry = sec_doc["verified_methods"]__DOT__get(method_id)
    if entry is True or (isinstance(entry, dict) and entry__DOT__get("status") == "PASS"):
        return STATUS_PASS, f"verified {method_id} via __DOT__gencode-gov/security-controls__DOT__yaml"
    if entry is False or (isinstance(entry, dict) and entry__DOT__get("status") == "FAIL"):
        return STATUS_FAIL, f"security control {method_id} marked FAIL in security-controls__DOT__yaml"
    return STATUS_BLOCKED, f"security control {method_id} not attested in security-controls__DOT__yaml"


def _verify_operational_artifact_method(
    method_id: str,
    root: Path,
    artifact_rel: str,
) -__GT__ tuple[str, str]:
    art = _safe_file(root, artifact_rel)
