{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohamedelghazali/GENCODE-GOV/schemas/review-attestation/1.0.0",
  "title": "GENCODE-GOV Human Review Attestation",
  "description": "Commit-bound, tamper-evident human engineering review attestation for hybrid governance rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "rule_ids",
    "reviewer",
    "approver_role",
    "commit_sha",
    "attested_at",
    "expires_at",
    "rationale",
    "reviewed_artifacts"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "pattern": "^ATTEST-[A-Z0-9-]{8,48}$"
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SE-[A-Z]+(-[A-Z]+)?-\\d{3,}$"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "approver_role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "attested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    },
    "reviewed_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
