{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apxoh.dev/schemas/integration-contract/1.0.0",
  "title": "Apxoh Integration Contract",
  "description": "Formal contract for external security or tool providers integrated with Apxoh.",
  "type": "object",
  "required": [
    "version",
    "provider",
    "consumer",
    "handshake",
    "evidence_contract",
    "failure_handling"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "consumer-provider",
        "peer",
        "observer"
      ]
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "minimum_version": {
          "type": "string"
        },
        "maximum_version": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "required_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "required": [
        "name",
        "role",
        "owns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "handshake": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "command_pattern": {
          "type": "string"
        },
        "output_format": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "required_fields",
        "freshness_window_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "freshness_window_hours": {
          "type": "integer",
          "minimum": 1
        },
        "integrity_check": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "failure_handling": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "gate_status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "gate_status": {
            "type": "string",
            "enum": [
              "BLOCKED",
              "FAIL",
              "PASS"
            ]
          },
          "reason": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "no_trust_without_verification": {
      "type": "boolean",
      "const": true
    }
  }
}
